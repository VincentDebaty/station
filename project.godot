; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Station"
config/description="Jeu d'aiguillage ferroviaire. Le poste d'aiguillage."
run/main_scene="res://jeu/app.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://jeu/icone.png"

[autoload]

Donnees="*res://jeu/donnees.gd"
Sauvegarde="*res://jeu/sauvegarde.gd"

[display]

window/size/viewport_width=1400
window/size/viewport_height=760
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
; PAYSAGE, DANS LES DEUX SENS. L'énumération de Godot est trompeuse : 0 est le
; paysage, 1 le PORTRAIT — et c'était 1. L'app s'ouvrait donc debout, le gril
; tassé en haut d'un écran de 3 045 unités de haut (mesuré sur l'iPhone de
; Vincent le 3 septembre 2026). 4 est le paysage libre, dans les deux sens :
; un poste d'aiguillage se lit en largeur, et le prototype web bloquait déjà
; le portrait.
window/handheld/orientation=4

[rendering]

; LA COMPRESSION DE TEXTURE D'UNE PLATEFORME MOBILE. Sans elle, l'export iOS
; refuse — et en ligne de commande il refuse SANS MESSAGE : la validation du
; préréglage est vide, l'avertissement vit ailleurs, dans le bandeau de la
; fenêtre d'export. Trouvé le 3 septembre 2026 en ouvrant l'éditeur, après
; une heure de suppositions à l'aveugle. Le jeu n'a qu'une texture (l'icône) :
; c'est une formalité, mais une formalité bloquante.
textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.0549, 0.0784, 0.1255, 1)
